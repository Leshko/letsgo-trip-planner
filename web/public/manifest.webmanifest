{
  "name": "LetsGo Together",
  "short_name": "LetsGo",
  "description": "Plan the family trip together: vote on things to do, see where you're staying, build the plan, share the photos.",
  "start_url": "/trip",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
